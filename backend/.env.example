# ---------- innovX VisualNav ----------
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# auto | cuda | cpu | mps
MODEL_DEVICE=auto

# real | demo   (demo never reports its metrics as real localization results)
APP_MODE=real

# Reference map is downscaled if larger than this on the long edge.
MAX_MAP_SIZE=8000

# Retrieval / matching
TOP_K_CANDIDATES=8
MAX_KEYPOINTS=4096
MATCHER=lightglue          # lightglue | sift
TILE_OVERLAP=0.35
TILE_SCALES=0.08,0.10,0.12,0.15,0.18,0.20,0.25
MAX_TILES=900
WORK_SIZE=960              # long edge used for feature extraction

# Geometric verification
RANSAC_THRESHOLD=7.5
MIN_INLIERS=15
MIN_INLIER_RATIO=0.30
MAX_REPROJECTION_ERROR=12.0
MIN_SPATIAL_COVERAGE=0.25
# Reject a homography that folds the frame into a non-convex quad.
# Sound for RGB->RGB; too strict for cross-domain (photo->roadmap).
CONVEXITY_GATE_ENABLED=true

# Decision thresholds
MATCH_CONFIDENCE=0.60
LOW_CONFIDENCE=0.40
AMBIGUITY_GAP=0.06

# Try 90/180/270 rotated query variants
ROTATION_SEARCH=true
# Evaluate every orientation for every candidate and keep the strongest,
# instead of only rotating when the upright attempt fails. Slower, more thorough.
ROTATION_SEARCH_ALWAYS=true
# Last-resort direct whole-map match when every candidate fails
GLOBAL_FALLBACK=true

# ---------- Cross-domain map representation (auxiliary, optional) ----------
# Build the OpenCV structural representation of the drone frame.
STRUCTURAL_MATCHING_ENABLED=true
# Sat2Map aerial->map translator. Off by default; the pipeline runs without it.
SAT2MAP_ENABLED=false
SAT2MAP_MODEL_PATH=weights/sat2map_best.pt
SAT2MAP_DEVICE=auto            # auto | cuda | cpu | mps
# Also retrieve DINO candidates from the translated-map representation and
# union them with the RGB shortlist.
MAP_DOMAIN_RETRIEVAL_ENABLED=false
MAP_DOMAIN_TOP_K=10
CANDIDATE_UNION_MAX=18
# How many of the strongest RGB-verified candidates get independent
# structural / map-domain matching + verification.
REPRESENTATION_MATCHING_TOP_N=3
# 0 => derive the consensus tolerance from the projected frame footprint.
REPRESENTATION_CONSENSUS_PX=0
# Initial (non-authoritative) fusion weights; normalised at use.
RGB_WEIGHT=0.40
STRUCTURAL_WEIGHT=0.25
SAT2MAP_WEIGHT=0.15
RETRIEVAL_WEIGHT=0.20
# Cross-representation fusion bounds. Agreeing auxiliary branches lift the
# reported confidence by at most CONSENSUS_BONUS_CAP (and only when the RGB
# homography passed); a disagreeing branch cuts it by up to CONSENSUS_PENALTY_CAP.
CONSENSUS_BONUS_CAP=0.20
CONSENSUS_PENALTY_CAP=0.35
# Optional reference-map type hint: satellite | roadmap | terrain | unknown
REFERENCE_MAP_TYPE=unknown
