# ---------- innovX VisualNav ----------
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# auto | cuda | cpu | mps
MODEL_DEVICE=auto

# real | demo   (demo never reports its metrics as real localization results)
APP_MODE=real

# Reference map is downscaled if larger than this on the long edge.
MAX_MAP_SIZE=8000

# Retrieval / matching
TOP_K_CANDIDATES=5
MAX_KEYPOINTS=2048
MATCHER=lightglue          # lightglue | sift
TILE_OVERLAP=0.25
TILE_SCALES=0.08,0.10,0.12,0.15,0.18,0.20,0.25
MAX_TILES=600
WORK_SIZE=640              # long edge used for feature extraction

# Geometric verification
RANSAC_THRESHOLD=5.0
MIN_INLIERS=15
MIN_INLIER_RATIO=0.18
MAX_REPROJECTION_ERROR=8.0
MIN_SPATIAL_COVERAGE=0.25

# Decision thresholds
MATCH_CONFIDENCE=0.60
LOW_CONFIDENCE=0.40
AMBIGUITY_GAP=0.06

# Try 90/180/270 rotated query variants when the upright match is weak
ROTATION_SEARCH=true
# Last-resort direct whole-map match when every candidate fails
GLOBAL_FALLBACK=true
