# ---------- innovX VisualNav ----------
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# auto | cuda | cpu | mps
MODEL_DEVICE=auto

# real | demo   (demo never reports its metrics as real localization results)
APP_MODE=real

# Reference map is downscaled if larger than this on the long edge.
MAX_MAP_SIZE=8000

# Retrieval / matching
TOP_K_CANDIDATES=8
MAX_KEYPOINTS=4096
MATCHER=lightglue          # lightglue | sift
# Strength-based keypoint filtering, applied before MAX_KEYPOINTS caps the
# count. These match today's library defaults - raise the thresholds /
# nms_radius, or lower the edge threshold, to keep only stronger points.
SUPERPOINT_DETECTION_THRESHOLD=0.0005
SUPERPOINT_NMS_RADIUS=4
SIFT_CONTRAST_THRESHOLD=0.04
SIFT_EDGE_THRESHOLD=10.0
# "Efficient matching" preset - applied per-request via the frontend's
# Efficient Matching toggle (LocalizeRequest.efficient_features), not as a
# standing default.
EFFICIENT_MAX_KEYPOINTS=1500
EFFICIENT_SUPERPOINT_DETECTION_THRESHOLD=0.005
EFFICIENT_SUPERPOINT_NMS_RADIUS=6
EFFICIENT_SIFT_CONTRAST_THRESHOLD=0.08
EFFICIENT_SIFT_EDGE_THRESHOLD=8.0
TILE_OVERLAP=0.35
TILE_SCALES=0.08,0.10,0.12,0.15,0.18,0.20,0.25
MAX_TILES=900
WORK_SIZE=960              # long edge used for feature extraction

# Geometric verification
RANSAC_THRESHOLD=7.5
MIN_INLIERS=15
MIN_INLIER_RATIO=0.30
MAX_REPROJECTION_ERROR=12.0
MIN_SPATIAL_COVERAGE=0.25

# Decision thresholds
MATCH_CONFIDENCE=0.60
LOW_CONFIDENCE=0.40
AMBIGUITY_GAP=0.06

# Try 90/180/270 rotated query variants
ROTATION_SEARCH=true
# Evaluate every orientation for every candidate and keep the strongest,
# instead of only rotating when the upright attempt fails. Slower, more thorough.
ROTATION_SEARCH_ALWAYS=true
# Last-resort direct whole-map match when every candidate fails
GLOBAL_FALLBACK=true

# ---------- Cross-domain map representation (auxiliary, optional) ----------
STRUCTURAL_MATCHING_ENABLED=true
SAT2MAP_ENABLED=false
SAT2MAP_MODEL_PATH=weights/sat2map_best.pt
SAT2MAP_DEVICE=auto
MAP_DOMAIN_RETRIEVAL_ENABLED=false
MAP_DOMAIN_TOP_K=10
CANDIDATE_UNION_MAX=18
REPRESENTATION_MATCHING_TOP_N=3
REPRESENTATION_CONSENSUS_PX=0
RGB_WEIGHT=0.40
STRUCTURAL_WEIGHT=0.25
SAT2MAP_WEIGHT=0.15
RETRIEVAL_WEIGHT=0.20
CONSENSUS_BONUS_CAP=0.20
CONSENSUS_PENALTY_CAP=0.35
REFERENCE_MAP_TYPE=unknown
